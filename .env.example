# Sigil — environment variables
#
# Copy to `.env.local` (which is gitignored; plain `.env` is ignored too, but
# `.env.local` is Vite's documented place for secrets and is what the code
# comments point at):
#
#     cp .env.example .env.local
#
# VITE_* variables are BUILD-TIME. Vite inlines them into the client bundle, so
# they are public — never put a secret in one. Everything else is RUNTIME, read
# by the serverless functions in `api/`, and must be set in the Vercel project
# rather than in a file that ships.
#
# The game runs with none of these set: it falls back to local-only play with no
# sign-in, no leaderboard and no analytics. That is fine for working on the rules
# engine, and it is the fastest way to get a clean clone running.


# ---------------------------------------------------------------------------
# Build-time (client, public)
# ---------------------------------------------------------------------------

# Google OAuth client id, from console.cloud.google.com → APIs & Services →
# Credentials → OAuth 2.0 Client ID. Authorized JavaScript origins must include
# every origin you serve from, including http://localhost:5173 for dev.
#
# ⚠ THE DANGEROUS ONE. If this is missing the app does NOT error — it silently
# swaps real Google sign-in for a local "dev sign-in" form that trusts whatever
# name you type. A production build without this variable ships that fake login
# to real users. Check it is set before every deploy.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# PostHog product analytics. Both are optional and independent of gameplay; with
# them unset the app simply records nothing. See PrivacyPolicy.jsx for what is
# and is not sent (deliberately no PII — issue 06).
VITE_PUBLIC_POSTHOG_TOKEN=phc_your_project_token
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ---------------------------------------------------------------------------
# Runtime (server, secret — set these in Vercel, not in a committed file)
# ---------------------------------------------------------------------------

# The SAME Google client id as above, without the VITE_ prefix. `/api/auth` uses
# it to verify the ID token the client sends, so it must match or every sign-in
# fails verification. Missing → /api/auth returns 503.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Signs and verifies session tokens (api/_lib/session.js). Any long random
# string; generate one with `openssl rand -base64 32`. Rotating it invalidates
# every player's session, forcing a re-sign-in — it does not lose their data,
# since saves are keyed by accountId. Missing → /api/auth returns 503.
SESSION_SECRET=generate-a-long-random-string

# Neon Postgres connection string, pooled. Used by every endpoint in `api/`.
# Missing → all of them 503, and the client falls back to local-only play.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Bearer token guarding /api/stats, which is what the /admin dashboard reads.
# Missing → /admin cannot load anything.
ADMIN_TOKEN=generate-a-long-random-string

# Guards /api/cron-backfill-runs so only Vercel's scheduler can trigger it.
# Vercel sends this automatically for configured crons; set it to the value in
# the project's cron settings. Missing → the weekly backfill is unauthorized and
# quietly stops running.
CRON_SECRET=generate-a-long-random-string
