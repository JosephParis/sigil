# Claude agent internals
.claude/

# Unattended dawn-run report. Written to the worktree root each run and read off
# disk by the launcher for the PR body -- it is a report *about* a run, not part
# of the project, so it must never be committed (see issue 22).
DAWN-SUMMARY.md

# Screenshots of the branch, taken by `npm run dawn:shots` for the morning
# email. Same reasoning as DAWN-SUMMARY.md: generated evidence about a run.
.dawn-shots/

.vercel

.env
.env.*
!.env.example

# Playwright visual-review output (the harness config + spec are tracked,
# but generated screenshots/results are not)
visual-screens/
test-results/
playwright-report/
.playwright/
